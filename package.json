{
  "name": "treadwheel",
  "version": "0.1.0",
  "description": "Time-release encryption for automated extraction deterrence",
  "author": "Johann Philipp Gorzny <jo-phil@gorzny.de>",
  "license": "Apache-2.0",
  "keywords": [
    "anti-automation",
    "anti-scraping",
    "computational-puzzle",
    "obfuscation",
    "proof-of-work",
    "time-lock-puzzle",
    "time-release-cryptography"
  ],
  "homepage": "https://github.com/jo-phil/treadwheel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-phil/treadwheel.git"
  },
  "bugs": {
    "url": "https://github.com/jo-phil/treadwheel/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/node/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": {
    "treadwheel": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      }
    },
    "./seal": {
      "node": {
        "types": "./dist/node/seal.d.ts",
        "import": "./dist/node/seal.js"
      },
      "browser": {
        "types": "./dist/browser/seal.d.ts",
        "import": "./dist/browser/seal.js"
      },
      "default": {
        "types": "./dist/browser/seal.d.ts",
        "import": "./dist/browser/seal.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/web-worker": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest"
  }
}
