{
  "name": "treadwheel",
  "version": "0.1.0",
  "description": "Time-release encryption for automated extraction deterrence",
  "keywords": [
    "anti-scraping",
    "bot-protection",
    "obfuscation",
    "proof-of-work",
    "spam-prevention",
    "time-lock-puzzle",
    "time-release-cryptography"
  ],
  "homepage": "https://github.com/jo-phil/treadwheel",
  "bugs": {
    "url": "https://github.com/jo-phil/treadwheel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-phil/treadwheel.git"
  },
  "license": "Apache-2.0",
  "author": "Johann Philipp Gorzny <jo-phil@gorzny.de>",
  "sideEffects": [
    "./dist/browser/widget.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      }
    },
    "./widget": "./dist/browser/widget.js"
  },
  "main": "./dist/node/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": "./dist/node/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && tsdown",
    "check": "tsc --noEmit",
    "clean": "rimraf dist",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:dev": "vitest unit",
    "validate": "pnpm check && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "execa": "^10.2.1",
    "magic-string": "^1.4.5",
    "nyc": "^18.0.0",
    "playwright": "^1.64.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.3",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
