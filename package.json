{
  "name": "treadwheel",
  "version": "0.1.0",
  "description": "Time-release encryption for automated extraction deterrence",
  "author": "Johann Philipp Gorzny <jo-phil@gorzny.de>",
  "license": "Apache-2.0",
  "keywords": [
    "anti-automation",
    "anti-scraping",
    "computational-puzzle",
    "obfuscation",
    "proof-of-work",
    "time-lock-puzzle",
    "time-release-cryptography"
  ],
  "homepage": "https://github.com/jo-phil/treadwheel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jo-phil/treadwheel.git"
  },
  "bugs": {
    "url": "https://github.com/jo-phil/treadwheel/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/node/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": "./dist/node/cli.js",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js"
      },
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      },
      "default": {
        "types": "./dist/browser/index.d.ts",
        "import": "./dist/browser/index.js"
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "execa": "^10.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "node --import tsx --test",
    "test:cov": "c8 -r text -r html pnpm test",
    "validate": "pnpm check && pnpm lint && pnpm test"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
